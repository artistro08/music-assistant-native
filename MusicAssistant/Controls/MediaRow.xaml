<UserControl
    x:Class="MusicAssistant.Controls.MediaRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12" Margin="24,0,24,24">

        <!-- Header -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="Pager" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="PageText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button x:Name="PrevButton" Click="OnPrev" Padding="6" AutomationProperties.Name="Previous page">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button x:Name="NextButton" Click="OnNext" Padding="6" AutomationProperties.Name="Next page">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
        <!-- /Header -->

        <!-- Slots: five equal star columns created once; paging only swaps their content.
             Slot buttons bleed 8px each side for their hover surface, so 28 leaves 12px between hover surfaces -->
        <Grid x:Name="Slots" ColumnSpacing="28" Background="Transparent" PointerWheelChanged="OnPointerWheel" />
    </StackPanel>
</UserControl>
