<UserControl
    x:Class="MusicAssistant.Controls.TopPicks"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12" Margin="24,0,24,24">

        <!-- Header -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Top Picks for You" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel x:Name="Pager" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="PageText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button x:Name="PrevButton" Click="OnPrev" Padding="6" AutomationProperties.Name="Previous page">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Button x:Name="NextButton" Click="OnNext" Padding="6" AutomationProperties.Name="Next page">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
        <!-- /Header -->

        <!-- Collage: lead tile spanning two rows, then columns of two tiles. Cells are star-sized so everything stretches. -->
        <Grid x:Name="Collage" ColumnSpacing="12" RowSpacing="12" Height="240" Background="Transparent" PointerWheelChanged="OnPointerWheel">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        </Grid>
        <!-- /Collage -->
    </StackPanel>
</UserControl>
