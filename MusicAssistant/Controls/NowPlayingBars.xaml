<UserControl
    x:Class="MusicAssistant.Controls.NowPlayingBars"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="18"
    Height="16"
    IsHitTestVisible="False">

    <UserControl.Resources>
        <!-- Each bar breathes between 25% and 100% height on its own rhythm; scale transforms keep it off the layout thread -->
        <Storyboard x:Name="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Bar1Scale" Storyboard.TargetProperty="ScaleY" From="0.35" To="1.0" Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bar2Scale" Storyboard.TargetProperty="ScaleY" From="1.0" To="0.25" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bar3Scale" Storyboard.TargetProperty="ScaleY" From="0.6" To="0.3" Duration="0:0:0.36">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bar4Scale" Storyboard.TargetProperty="ScaleY" From="0.45" To="0.9" Duration="0:0:0.48">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <!-- Bars -->
    <Grid ColumnSpacing="3" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar1Scale" ScaleY="0.35" /></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Grid.Column="1" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar2Scale" ScaleY="1.0" /></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Grid.Column="2" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar3Scale" ScaleY="0.6" /></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Grid.Column="3" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform><ScaleTransform x:Name="Bar4Scale" ScaleY="0.45" /></Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
    <!-- /Bars -->
</UserControl>
