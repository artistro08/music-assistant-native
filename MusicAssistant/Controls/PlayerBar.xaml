<UserControl
    x:Class="MusicAssistant.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:MusicAssistant.Api"
    xmlns:controls="using:MusicAssistant.Controls"
    xmlns:local="using:MusicAssistant">

    <Grid
        Height="96"
        Padding="16,8"
        ColumnSpacing="16"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="160" />
            <ColumnDefinition Width="5*" MinWidth="240" />
            <!-- Right side sizes to its content so nothing gets clipped -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Now Playing -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="64" Height="64" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <FontIcon Glyph="&#xEC4F;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Image x:Name="ArtImage" Stretch="UniformToFill" Opacity="0" ImageOpened="OnImageOpened" />
                <Grid x:Name="LoadingOverlay" Background="#80000000" Visibility="Collapsed">
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Foreground="White" Width="28" Height="28" />
                </Grid>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MaxWidth="280">
                <!-- Star column so the title trims with an ellipsis; the chip keeps its own width -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Text="Nothing playing" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <!-- Quality Chip -->
                    <Border x:Name="QualityChip" Grid.Column="1" Padding="6,1" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse x:Name="QualityDot" Width="7" Height="7" VerticalAlignment="Center" />
                            <TextBlock x:Name="QualityText" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="SubtitleText" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <!-- Plain icon: no hover chrome, no tooltip; the heart fill is the only state -->
            <Button x:Name="LikeButton" Grid.Column="2" VerticalAlignment="Center" Padding="8" Click="OnLike" AutomationProperties.Name="Favorite">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" />
                    </ControlTemplate>
                </Button.Template>
                <FontIcon x:Name="LikeIcon" Glyph="&#xEB51;" FontSize="16" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <ScaleTransform x:Name="LikeScale" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
        </Grid>
        <!-- /Now Playing -->

        <!-- Transport -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                <Button x:Name="ShuffleButton" Style="{StaticResource SubtleButtonStyle}" Click="OnShuffle" ToolTipService.ToolTip="Shuffle">
                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                </Button>
                <Button x:Name="PreviousButton" Style="{StaticResource SubtleButtonStyle}" Click="OnPrevious" ToolTipService.ToolTip="Previous">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>
                <Button x:Name="PlayPauseButton" Style="{StaticResource AccentButtonStyle}" Width="40" Height="40" CornerRadius="20" Padding="0" Click="OnPlayPause" ToolTipService.ToolTip="Play / Pause">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource SubtleButtonStyle}" Click="OnNext" ToolTipService.ToolTip="Next">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
                <Button x:Name="RepeatButton" Style="{StaticResource SubtleButtonStyle}" Click="OnRepeat" ToolTipService.ToolTip="Repeat">
                    <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="14" />
                </Button>
            </StackPanel>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ElapsedText" Text="0:00" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="1" IsThumbToolTipEnabled="False" PointerCaptureLost="OnSeekCommitted" />
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
        <!-- /Transport -->

        <!-- Volume + Player -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
            <Button x:Name="MuteButton" Style="{StaticResource SubtleButtonStyle}" Click="OnMute" ToolTipService.ToolTip="Mute">
                <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" />
            </Button>
            <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="OnVolumeChanged" />

            <!-- Compact volume: shown instead of the inline slider on narrow windows -->
            <Button x:Name="VolumeFlyoutButton" Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed" ToolTipService.ToolTip="Volume" AutomationProperties.Name="Volume">
                <FontIcon x:Name="VolumeFlyoutIcon" Glyph="&#xE767;" FontSize="16" />
                <Button.Flyout>
                    <Flyout Placement="Top" Opening="OnVolumeFlyoutOpening">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock x:Name="VolumePercentText" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            <Slider x:Name="VolumeFlyoutSlider" Orientation="Vertical" Height="140" Minimum="0" Maximum="100" HorizontalAlignment="Center" ValueChanged="OnVolumeChanged" />
                            <Button Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Center" Click="OnMute" ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute">
                                <FontIcon x:Name="VolumeFlyoutMuteIcon" Glyph="&#xE767;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="PowerButton" Style="{StaticResource SubtleButtonStyle}" Click="OnPower" ToolTipService.ToolTip="Power">
                <FontIcon Glyph="&#xE7E8;" FontSize="16" />
            </Button>
            <!-- Plain icon like the heart: no hover chrome; accent-colored icon while the queue is open -->
            <ToggleButton x:Name="QueueButton" Height="32" Padding="10,0" Click="OnQueue" AutomationProperties.Name="Queue">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <ContentPresenter Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                    </ControlTemplate>
                </ToggleButton.Template>
                <FontIcon x:Name="QueueIcon" Glyph="&#xE8FD;" FontSize="16" />
            </ToggleButton>
            <DropDownButton x:Name="PlayerPicker" Height="32" ToolTipService.ToolTip="Select player">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Speaker icon, swapped for the live bars while the current player plays -->
                    <FontIcon x:Name="PlayerIcon" Glyph="&#xE7F5;" FontSize="14" />
                    <controls:NowPlayingBars x:Name="PlayerLive" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="PlayerNameText" Text="No player" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <!-- Player Picker: check mark on the selected player, live bars on players that are playing -->
                    <Flyout x:Name="PlayerFlyout" Placement="Top" Opening="OnPlayerMenuOpening">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="MinWidth" Value="260" />
                                <Setter Property="MaxHeight" Value="480" />
                                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Grid>
                            <ListView x:Name="PlayerList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnPlayerPicked">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="api:Player">
                                        <Grid ColumnSpacing="12" MinHeight="36" AutomationProperties.Name="{x:Bind DisplayName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" VerticalAlignment="Center" Visibility="{x:Bind local:Templates.ActiveVis(PlayerId)}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <controls:NowPlayingBars Grid.Column="2" VerticalAlignment="Center" Visibility="{x:Bind local:Templates.Vis(IsPlaying)}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="NoPlayersText" Text="No players available" Margin="12,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Flyout>
                    <!-- /Player Picker -->
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>
        <!-- /Volume + Player -->

        <!-- Narrow windows: drop the volume slider first, then the player name -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumeSlider.Visibility" Value="Collapsed" />
                        <Setter Target="MuteButton.Visibility" Value="Collapsed" />
                        <Setter Target="VolumeFlyoutButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumeSlider.Visibility" Value="Collapsed" />
                        <Setter Target="MuteButton.Visibility" Value="Collapsed" />
                        <Setter Target="VolumeFlyoutButton.Visibility" Value="Visible" />
                        <Setter Target="QualityChip.Visibility" Value="Collapsed" />
                        <Setter Target="PlayerNameText.Visibility" Value="Collapsed" />
                        <Setter Target="SubtitleText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
