<UserControl
    x:Class="MusicAssistant.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:MusicAssistant.Api"
    xmlns:controls="using:MusicAssistant.Controls"
    xmlns:local="using:MusicAssistant">

    <UserControl.Resources>
        <!-- Plain Icon Button: no hover or press background, just the icon. Same padding everywhere keeps the transport row symmetric
             around play. Disabled buttons are dimmed in code (PlayerBar constructor); no visual states in the template -->
        <Style x:Key="PlainIconButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="BarRoot"
        Height="96"
        Padding="16,8"
        ColumnSpacing="16"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        SizeChanged="OnBarSizeChanged">
        <!-- Both side columns always get the same width (set in BalanceColumns), so the transport sits at the true center of the window -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightColumn" Width="240" />
        </Grid.ColumnDefinitions>

        <!-- Now Playing: the whole block is a plain button that opens and closes the queue, like the queue button -->
        <Button Style="{StaticResource PlainIconButtonStyle}" Padding="0" HorizontalAlignment="Stretch" Click="OnQueue" AutomationProperties.Name="Show queue">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- Star column so the text shrinks on narrow windows instead of overflowing the column -->
                    <ColumnDefinition Width="*" MaxWidth="280" />
                </Grid.ColumnDefinitions>
                <Grid Width="64" Height="64" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xEC4F;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Image x:Name="ArtImage" Stretch="UniformToFill" Opacity="0" ImageOpened="OnImageOpened" />
                    <Grid x:Name="LoadingOverlay" Background="#80000000" Visibility="Collapsed">
                        <ProgressRing x:Name="LoadingRing" IsActive="False" Foreground="White" Width="28" Height="28" />
                    </Grid>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <!-- Trimmed text gets its full value as a tooltip (see TrimTip) -->
                    <TextBlock x:Name="TitleText" Text="Nothing playing" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextTrimmedChanged="OnTextTrimmedChanged" />
                    <TextBlock x:Name="SubtitleText" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextTrimmedChanged="OnTextTrimmedChanged" />
                    <!-- Quality Chip: its own line under the artist so it never competes with the title for width -->
                    <Border x:Name="QualityChip" Padding="6,1" Margin="0,2,0,0" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse x:Name="QualityDot" Width="7" Height="7" VerticalAlignment="Center" />
                            <TextBlock x:Name="QualityText" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Button>
        <!-- /Now Playing -->

        <!-- Transport: heart and queue bookend the transport row -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                <!-- Plain icon: no hover chrome, no tooltip; the heart fill is the only state. Same width as the queue button at the other end, so play stays centered -->
                <Button x:Name="LikeButton" Style="{StaticResource PlainIconButtonStyle}" Click="OnLike" AutomationProperties.Name="Favorite">
                    <FontIcon x:Name="LikeIcon" Glyph="&#xEB51;" FontSize="16" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <ScaleTransform x:Name="LikeScale" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>
                <Button x:Name="ShuffleButton" Style="{StaticResource PlainIconButtonStyle}" Click="OnShuffle" ToolTipService.ToolTip="Shuffle" AutomationProperties.Name="Shuffle">
                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                </Button>
                <Button x:Name="PreviousButton" Style="{StaticResource PlainIconButtonStyle}" Click="OnPrevious" ToolTipService.ToolTip="Previous" AutomationProperties.Name="Previous">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>
                <Button x:Name="PlayPauseButton" Style="{StaticResource AccentButtonStyle}" Width="40" Height="40" CornerRadius="20" Padding="0" Click="OnPlayPause" ToolTipService.ToolTip="Play / Pause" AutomationProperties.Name="Play or pause">
                    <Grid>
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16" />
                        <!-- Shown instead of the glyph while a resume is waiting for the player to start -->
                        <ProgressRing x:Name="PlayPauseRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Grid>
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource PlainIconButtonStyle}" Click="OnNext" ToolTipService.ToolTip="Next" AutomationProperties.Name="Next">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
                <Button x:Name="RepeatButton" Style="{StaticResource PlainIconButtonStyle}" Click="OnRepeat" ToolTipService.ToolTip="Repeat" AutomationProperties.Name="Repeat">
                    <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="14" />
                </Button>
                <!-- Plain icon like the heart: no hover chrome; accent-colored icon while the queue is open -->
                <ToggleButton x:Name="QueueButton" Height="32" Padding="10,0" Click="OnQueue" AutomationProperties.Name="Queue">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <ContentPresenter Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <FontIcon x:Name="QueueIcon" Glyph="&#xE8FD;" FontSize="16" />
                </ToggleButton>
            </StackPanel>

            <!-- Seek Bar: the thumb only shows while hovering a seekable bar or dragging. Clicking the elapsed time switches it to the time left -->
            <!-- 16px gaps: the thumb is centered on the value, so at either end it reaches 11px past the track toward the times -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ElapsedButton" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnElapsedClick" ToolTipService.ToolTip="Show time left" AutomationProperties.Name="Elapsed time">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="ElapsedText" Text="0:00" Style="{StaticResource CaptionTextBlockStyle}" />
                </Button>
                <Grid x:Name="SeekArea" Grid.Column="1" Background="Transparent">
                    <!-- The template's own thumb is zero width so the filled track runs exactly to the value (at full length it
                         used to stop one thumb short). A drawn thumb centered on the value grows in on hover instead.
                         Hover is tracked on this Grid (wired in code with handledEventsToo): the Slider handles its own pointer exits -->
                    <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" StepFrequency="1" IsThumbToolTipEnabled="False" PointerCaptureLost="OnSeekCommitted" ValueChanged="OnProgressValueChanged" SizeChanged="OnProgressSizeChanged">
                        <Slider.Resources>
                            <x:Double x:Key="SliderHorizontalThumbWidth">0</x:Double>
                            <x:Double x:Key="SliderHorizontalThumbHeight">0</x:Double>
                        </Slider.Resources>
                    </Slider>
                    <Canvas IsHitTestVisible="False">
                        <!-- Same build as the Fluent slider thumb: 22px outer circle with the elevation border, 12px accent dot
                             at 86% normally, 117% while the pointer is over the thumb, 71% while pressed -->
                        <Grid x:Name="SeekThumb" Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SeekThumbScale" ScaleX="0" ScaleY="0" />
                            </Grid.RenderTransform>
                            <Ellipse Fill="{ThemeResource ControlSolidFillColorDefaultBrush}" Stroke="{ThemeResource ControlElevationBorderBrush}" StrokeThickness="1" />
                            <Ellipse Width="12" Height="12" Fill="{ThemeResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="SeekInnerScale" ScaleX="0.86" ScaleY="0.86" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Canvas>
                </Grid>
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </Grid>
            <!-- /Seek Bar -->
        </StackPanel>
        <!-- /Transport -->

        <!-- Volume + Player: one row, even gaps, hugging the right edge -->
        <StackPanel x:Name="RightPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
            <Button x:Name="MuteButton" Style="{StaticResource SubtleButtonStyle}" Click="OnMute" PointerWheelChanged="OnVolumeWheel" ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute">
                <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" />
            </Button>
            <!-- Extra right margin widens the gap between the volume group and the player controls -->
            <Slider x:Name="VolumeSlider" Width="100" Margin="0,0,8,0" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="OnVolumeChanged" PointerWheelChanged="OnVolumeWheel" />

            <!-- Compact volume: shown instead of the inline slider on narrow windows -->
            <Button x:Name="VolumeFlyoutButton" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0" Visibility="Collapsed" PointerWheelChanged="OnVolumeWheel" ToolTipService.ToolTip="Volume" AutomationProperties.Name="Volume">
                <FontIcon x:Name="VolumeFlyoutIcon" Glyph="&#xE767;" FontSize="16" />
                <Button.Flyout>
                    <Flyout Placement="Top" Opening="OnVolumeFlyoutOpening">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock x:Name="VolumePercentText" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                            <Slider x:Name="VolumeFlyoutSlider" Orientation="Vertical" Height="140" Minimum="0" Maximum="100" HorizontalAlignment="Center" ValueChanged="OnVolumeChanged" PointerWheelChanged="OnVolumeWheel" />
                            <Button Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Center" Click="OnMute" ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute">
                                <FontIcon x:Name="VolumeFlyoutMuteIcon" Glyph="&#xE767;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="PowerButton" Style="{StaticResource SubtleButtonStyle}" Click="OnPower" ToolTipService.ToolTip="Power" AutomationProperties.Name="Power">
                <FontIcon Glyph="&#xE7E8;" FontSize="16" />
            </Button>
            <DropDownButton x:Name="PlayerPicker" Height="32" ToolTipService.ToolTip="Select player">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7F5;" FontSize="14" />
                    <TextBlock x:Name="PlayerNameText" Text="No player" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <!-- Player Picker: check mark on the selected player, live bars on players that are playing -->
                    <Flyout x:Name="PlayerFlyout" Placement="Top" Opening="OnPlayerMenuOpening">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="MinWidth" Value="260" />
                                <Setter Property="MaxHeight" Value="480" />
                                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Grid>
                            <ListView x:Name="PlayerList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnPlayerPicked">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="api:Player">
                                        <Grid ColumnSpacing="12" MinHeight="36" AutomationProperties.Name="{x:Bind DisplayName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" VerticalAlignment="Center" Visibility="{x:Bind local:Templates.ActiveVis(PlayerId)}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <controls:NowPlayingBars Grid.Column="2" VerticalAlignment="Center" Visibility="{x:Bind local:Templates.Vis(IsPlaying)}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="NoPlayersText" Text="No players available" Margin="12,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Flyout>
                    <!-- /Player Picker -->
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>
        <!-- /Volume + Player -->

        <!-- Narrow windows: drop the volume slider first, then the player name. The widths leave the centered transport
             enough room once both side columns are as wide as the right group -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup CurrentStateChanged="OnBarStateChanged">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumeSlider.Visibility" Value="Collapsed" />
                        <Setter Target="MuteButton.Visibility" Value="Collapsed" />
                        <Setter Target="VolumeFlyoutButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumeSlider.Visibility" Value="Collapsed" />
                        <Setter Target="MuteButton.Visibility" Value="Collapsed" />
                        <Setter Target="VolumeFlyoutButton.Visibility" Value="Visible" />
                        <Setter Target="PlayerNameText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
