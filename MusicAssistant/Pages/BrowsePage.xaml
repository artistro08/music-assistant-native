<Page
    x:Class="MusicAssistant.Pages.BrowsePage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,16,24,8" Spacing="8" MaxWidth="{StaticResource ContentMaxWidth}">
            <TextBlock Text="Browse" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="PathText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ListView x:Name="List" Grid.Row="1" Padding="24,0,24,24" Style="{StaticResource TrackListStyle}" ItemClick="OnItemClick">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel MaxWidth="{StaticResource ContentMaxWidth}" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>
        <ProgressRing x:Name="Busy" Grid.Row="1" IsActive="True" VerticalAlignment="Top" Margin="0,24" />
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="This folder is empty." Margin="32,16" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
