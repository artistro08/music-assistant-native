<Page
    x:Class="MusicAssistant.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel
            Width="380"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="16"
            Padding="32"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">

            <StackPanel Spacing="4">
                <FontIcon Glyph="&#xEC4F;" FontSize="32" HorizontalAlignment="Left" />
                <TextBlock Text="Sign in to Music Assistant" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Use the same account you use in the web interface." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" />

            <TextBox x:Name="ServerBox" Header="Server address" PlaceholderText="http://192.168.1.10:8095" InputScope="Url" TextChanged="OnTargetChanged" />
            <TextBox x:Name="RemoteIdBox" Header="Remote ID (optional, for away from home)" PlaceholderText="XXXXXXXX-XXXXX-XXXXX-XXXXXXXX" CharacterCasing="Upper" TextChanged="OnTargetChanged" />
            <TextBlock Text="Find the Remote ID under Settings › Remote access in Music Assistant. With both filled in, the app uses your home network when it can and the remote connection when it can't." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBox x:Name="UsernameBox" Header="Username" />
            <PasswordBox x:Name="PasswordBox" Header="Password" KeyDown="OnPasswordKeyDown" />

            <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnSignIn" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock Grid.Column="1" Text="or" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Grid>

            <Button x:Name="HomeAssistantButton" HorizontalAlignment="Stretch" Click="OnSignInWithHomeAssistant" AutomationProperties.Name="Sign in with Home Assistant">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE80F;" FontSize="14" />
                    <TextBlock Text="Sign in with Home Assistant" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Stretch" Click="OnCancel" Visibility="Collapsed" />

            <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
