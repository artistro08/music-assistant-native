<Page
    x:Class="MusicAssistant.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- Section Header ("NOW PLAYING", "UP NEXT 7") -->
        <Style x:Key="QueueSectionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Padding="16,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Left" Click="OnClose" AutomationProperties.Name="Close now playing">
                <FontIcon Glyph="&#xE70D;" FontSize="14" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="AutoplayToggle" Click="OnAutoplay" ToolTipService.ToolTip="Keep playing similar music when the queue ends">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock Text="Autoplay" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="CrossfadeToggle" Click="OnCrossfade" ToolTipService.ToolTip="Crossfade between tracks">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71B;" FontSize="14" />
                        <TextBlock Text="Crossfade" />
                    </StackPanel>
                </ToggleButton>
                <!-- Transfer Queue: the menu lists the other players, rebuilt each time it opens -->
                <DropDownButton x:Name="TransferButton" ToolTipService.ToolTip="Move this queue to another player" AutomationProperties.Name="Transfer queue">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                        <TextBlock Text="Transfer queue" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="TransferMenu" Placement="BottomEdgeAlignedRight" Opening="OnTransferMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Content="Clear queue" Click="OnClear" />
            </StackPanel>
        </Grid>
        <!-- /Top Bar -->

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="24" Padding="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Now Playing -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24" MaxWidth="560">
                <!-- Shrinks with its column on narrow windows instead of overflowing into the queue list -->
                <Viewbox MaxWidth="380" MaxHeight="380" Stretch="Uniform">
                    <Grid Width="380" Height="380" CornerRadius="{StaticResource OverlayCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xEC4F;" FontSize="64" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Image x:Name="ArtImage" Stretch="UniformToFill" Opacity="0" ImageOpened="OnImageOpened" />
                    </Grid>
                </Viewbox>
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleLargeTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistText" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <!-- /Now Playing -->

            <!-- Queue: three separate lists so a drag can never cross sections. Only Up Next reorders; already played
                 tracks and the track playing now ride along in its header, so everything scrolls as one and Up Next
                 stays virtualized -->
            <Grid Grid.Column="1">
                <ListView
                    x:Name="UpNextList"
                    ItemTemplate="{StaticResource QueueRowTemplate}"
                    ItemContainerStyle="{StaticResource TrackListItemStyle}"
                    IsItemClickEnabled="True"
                    SelectionMode="None"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    ItemClick="OnItemClick"
                    DragItemsStarting="OnDragStarting"
                    DragItemsCompleted="OnDragCompleted">
                    <ListView.Header>
                        <StackPanel>

                            <!-- Played: dimmed, click to play again, not reorderable. Inside the header it is not virtualized
                                 (ponytail: a queue with hundreds of played tracks realizes all of them; cap or collapse it if that shows up in memory) -->
                            <ListView
                                x:Name="PlayedList"
                                ItemTemplate="{StaticResource QueueRowTemplate}"
                                ItemContainerStyle="{StaticResource TrackListItemStyle}"
                                IsItemClickEnabled="True"
                                SelectionMode="None"
                                Opacity="0.5"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ItemClick="OnItemClick" />
                            <!-- /Played -->

                            <!-- Now Playing: a single row, selected for the accent line, never draggable or a drop target -->
                            <StackPanel x:Name="NowPlayingSection" Visibility="Collapsed">
                                <Grid ColumnSpacing="12" Padding="4,16,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NOW PLAYING" Style="{StaticResource QueueSectionTextStyle}" />
                                    <Rectangle Grid.Column="1" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <ListView
                                    x:Name="NowPlayingList"
                                    ItemTemplate="{StaticResource QueueRowTemplate}"
                                    ItemContainerStyle="{StaticResource TrackListItemStyle}"
                                    IsItemClickEnabled="True"
                                    SelectionMode="Single"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ItemClick="OnItemClick" />
                            </StackPanel>
                            <!-- /Now Playing -->

                            <!-- Up Next header; its rows are this list's items -->
                            <Grid x:Name="UpNextHeader" ColumnSpacing="12" Padding="4,16,4,4" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UpNextText" Style="{StaticResource QueueSectionTextStyle}" />
                                <Rectangle Grid.Column="1" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                            </Grid>

                        </StackPanel>
                    </ListView.Header>
                </ListView>
                <ProgressRing x:Name="Busy" IsActive="True" />
                <TextBlock x:Name="EmptyText" Text="The queue is empty." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <!-- /Queue -->
        </Grid>
        <!-- /Body -->
    </Grid>
</Page>
