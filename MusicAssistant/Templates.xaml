<ResourceDictionary
    x:Class="MusicAssistant.Templates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:MusicAssistant.Api"
    xmlns:controls="using:MusicAssistant.Controls"
    xmlns:local="using:MusicAssistant">

    <!-- Shared Brushes -->
    <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#33000000" Offset="0.45" />
        <GradientStop Color="#D9000000" Offset="1" />
    </LinearGradientBrush>

    <!-- Plain Card Button: no hover or press chrome, the card content draws itself (MediaRow adds a tint overlay in code) -->
    <Style x:Key="PlainCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Media Card (library, search, rows) -->
    <DataTemplate x:Key="MediaCardTemplate" x:DataType="api:MediaItem">
        <StackPanel Spacing="8" AutomationProperties.Name="{x:Bind Name}">
            <StackPanel.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Play now" Icon="Play" Click="OnPlayNow" />
                    <MenuFlyoutItem Text="Play next" Icon="Next" Click="OnPlayNext" />
                    <MenuFlyoutItem Text="Add to queue" Icon="Add" Click="OnAddToQueue" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Toggle favorite" Icon="Favorite" Click="OnToggleFavorite" />
                </MenuFlyout>
            </StackPanel.ContextFlyout>

            <!-- Square art box: a Viewbox scales a fixed square to the card width in one layout pass, so resizing never re-layouts twice -->
            <Viewbox Stretch="Uniform">
                <Grid Width="184" Height="184" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Image Source="{x:Bind local:Templates.ToImage(ThumbUrl)}" Opacity="{x:Bind local:Templates.Ready(ThumbUrl)}" Stretch="UniformToFill" ImageOpened="OnImageOpened" />
                    <Grid Background="#80000000" Visibility="{x:Bind IsLoading, Mode=OneWay}">
                        <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Foreground="White" Width="40" Height="40" />
                    </Grid>
                </Grid>
            </Viewbox>

            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind SubtitleText}" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
    <!-- /Media Card -->

    <!-- Card Button: the media card inside a subtle, rounded button (hover/press surface with 8px breathing room) -->
    <DataTemplate x:Key="CardButtonTemplate" x:DataType="api:MediaItem">
        <Button
            Style="{StaticResource SubtleButtonStyle}"
            Content="{x:Bind}"
            ContentTemplate="{StaticResource MediaCardTemplate}"
            Padding="8"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Top"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Click="OnCardClick"
            AutomationProperties.Name="{x:Bind Name}" />
    </DataTemplate>
    <!-- /Card Button -->

    <!-- Bare item container: no built-in chrome, the card button draws its own hover -->
    <Style x:Key="BareGridViewItemStyle" TargetType="GridViewItem">
        <!-- 12px between cards so neighboring hover surfaces do not touch; split evenly so the panel can bleed
             symmetrically (LibraryPage) and the first and last artwork line up with the page content edges -->
        <Setter Property="Margin" Value="6,0,6,12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Player Card (home page players row) -->
    <DataTemplate x:Key="PlayerCardTemplate" x:DataType="api:Player">
        <Grid
            Height="64"
            Padding="12,0"
            ColumnSpacing="12"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Background="{x:Bind local:Templates.PlayerBackground(PlayerId)}"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            AutomationProperties.Name="{x:Bind DisplayName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Type icon, replaced by the artwork of whatever the player has on -->
            <Border Width="40" Height="40" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <Grid>
                    <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="16" Foreground="{x:Bind local:Templates.PlayerForeground(PlayerId)}" />
                    <Image Source="{x:Bind local:Templates.ToThumb(ArtUrl)}" Stretch="UniformToFill" Visibility="{x:Bind local:Templates.Vis(HasMedia)}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{x:Bind local:Templates.PlayerForeground(PlayerId)}" />
                <TextBlock Text="{x:Bind NowPlayingText}" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind local:Templates.PlayerSecondary(PlayerId)}" />
            </StackPanel>

            <!-- Live indicator: pulsing bars while the player plays (on-accent color on the selected card) -->
            <controls:NowPlayingBars Grid.Column="2" Width="26" Height="22" Foreground="{x:Bind local:Templates.PlayerBars(PlayerId)}" Visibility="{x:Bind local:Templates.Vis(IsPlaying)}" />
        </Grid>
    </DataTemplate>
    <!-- /Player Card -->

    <!-- Hero Card (Top Picks collage tiles) -->
    <DataTemplate x:Key="HeroCardTemplate" x:DataType="api:MediaItem">
        <Grid CornerRadius="{StaticResource OverlayCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" AutomationProperties.Name="{x:Bind Name}">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Play now" Icon="Play" Click="OnPlayNow" />
                    <MenuFlyoutItem Text="Play next" Icon="Next" Click="OnPlayNext" />
                    <MenuFlyoutItem Text="Add to queue" Icon="Add" Click="OnAddToQueue" />
                </MenuFlyout>
            </Grid.ContextFlyout>
            <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <Image Source="{x:Bind local:Templates.ToLargeImage(LargeImageUrl)}" Opacity="{x:Bind local:Templates.ReadyLarge(LargeImageUrl)}" Stretch="UniformToFill" ImageOpened="OnImageOpened" />
            <Rectangle Fill="{StaticResource HeroScrimBrush}" />
            <Grid Background="#80000000" Visibility="{x:Bind IsLoading, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Foreground="White" Width="40" Height="40" />
            </Grid>
            <StackPanel VerticalAlignment="Bottom" Padding="12" Spacing="1">
                <TextBlock Text="{x:Bind TagText}" FontSize="10" FontWeight="SemiBold" Foreground="#E6FFFFFF" CharacterSpacing="60" VerticalAlignment="Top" Margin="0,0,0,10" />
                <TextBlock Text="{x:Bind TypeLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#CCFFFFFF" />
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{x:Bind SubtitleText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
        </Grid>
    </DataTemplate>
    <!-- /Hero Card -->

    <!-- Track Row -->
    <DataTemplate x:Key="TrackRowTemplate" x:DataType="api:MediaItem">
        <Grid ColumnSpacing="12" Padding="4,6" MinHeight="48" AutomationProperties.Name="{x:Bind Name}">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Play now" Icon="Play" Click="OnPlayNow" />
                    <MenuFlyoutItem Text="Play next" Icon="Next" Click="OnPlayNext" />
                    <MenuFlyoutItem Text="Add to queue" Icon="Add" Click="OnAddToQueue" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Toggle favorite" Icon="Favorite" Click="OnToggleFavorite" />
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="40" Height="40" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Image Source="{x:Bind local:Templates.ToThumb(ThumbUrl)}" Opacity="{x:Bind local:Templates.ReadyThumb(ThumbUrl)}" Stretch="UniformToFill" ImageOpened="OnImageOpened" />
                <Grid Background="#80000000" Visibility="{x:Bind IsLoading, Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Foreground="White" Width="20" Height="20" />
                </Grid>
            </Grid>

            <!-- Bottom margins lift the text: its line boxes carry more space above the capitals than below the letters,
                 so a centered box drew the ink about 1.5px low against the art and the row's hover background -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,3">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{x:Bind SubtitleText}" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <controls:NowPlayingBars Grid.Column="2" Width="18" Height="14" VerticalAlignment="Center" Visibility="{x:Bind local:Templates.Vis(IsNowPlaying), Mode=OneWay}" />
            <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" VerticalAlignment="Center" Margin="0,0,0,2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind local:Templates.VisNot(IsNowPlaying), Mode=OneWay}" />
        </Grid>
    </DataTemplate>
    <!-- /Track Row -->

    <!-- Queue Row -->
    <DataTemplate x:Key="QueueRowTemplate" x:DataType="api:QueueItem">
        <Grid ColumnSpacing="12" Padding="4,6" MinHeight="48" AutomationProperties.Name="{x:Bind Name}">
            <Grid.Resources>
                <MenuFlyout x:Key="QueueMenu">
                    <MenuFlyoutItem Text="Play now" Icon="Play" Click="OnQueuePlayHere" />
                    <MenuFlyoutItem Text="Play next" Icon="Next" Click="OnQueuePlayNext" />
                    <MenuFlyoutItem Text="Move to end" Icon="Download" Click="OnQueueMoveEnd" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Delete item" Icon="Delete" Click="OnQueueRemove" />
                </MenuFlyout>
            </Grid.Resources>
            <Grid.ContextFlyout>
                <StaticResource ResourceKey="QueueMenu" />
            </Grid.ContextFlyout>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="40" Height="40" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <FontIcon Glyph="&#xEC4F;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Image Source="{x:Bind local:Templates.ToThumb(ThumbUrl)}" Opacity="{x:Bind local:Templates.ReadyThumb(ThumbUrl)}" Stretch="UniformToFill" ImageOpened="OnImageOpened" />
            </Grid>

            <!-- Same lift as the track row: centered line boxes draw the ink low -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,3">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{x:Bind SubtitleText}" TextTrimming="CharacterEllipsis" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <controls:NowPlayingBars Grid.Column="2" Width="18" Height="14" VerticalAlignment="Center" Visibility="{x:Bind local:Templates.Vis(IsNowPlaying), Mode=OneWay}" />
            <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" VerticalAlignment="Center" Margin="0,0,0,2" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind local:Templates.VisNot(IsNowPlaying), Mode=OneWay}" />

            <!-- Drag handle: the row itself is draggable; this just signals it -->
            <Grid Grid.Column="3" VerticalAlignment="Center" Padding="6,0" RowSpacing="3" ColumnSpacing="3" ToolTipService.ToolTip="Drag to reorder">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorTertiaryBrush}" Grid.Column="1" />
                <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorTertiaryBrush}" Grid.Row="1" />
                <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorTertiaryBrush}" Grid.Row="1" Grid.Column="1" />
                <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorTertiaryBrush}" Grid.Row="2" />
                <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorTertiaryBrush}" Grid.Row="2" Grid.Column="1" />
            </Grid>

            <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Padding="6" Flyout="{StaticResource QueueMenu}" AutomationProperties.Name="Queue item actions">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
            </Button>
        </Grid>
    </DataTemplate>
    <!-- /Queue Row -->


    <!-- Page content is capped and centered, Microsoft Store style; scrollers stay full width -->
    <x:Double x:Key="ContentMaxWidth">1600</x:Double>

    <!-- Row container for track and queue lists: the default 16/12px side padding put the art 16px inside the hover
         background but only 4px below its top. 4px on each side makes the row content sit evenly inside the hover and
         selection background, and lines the art up with the page's section titles -->
    <Style x:Key="TrackListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="4,0,4,0" />
    </Style>

    <Style x:Key="TrackListStyle" TargetType="ListView">
        <Setter Property="ItemTemplate" Value="{StaticResource TrackRowTemplate}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource TrackListItemStyle}" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="SelectionMode" Value="None" />
    </Style>

    <Style x:Key="PageHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="24,16,24,8" />
    </Style>
</ResourceDictionary>
