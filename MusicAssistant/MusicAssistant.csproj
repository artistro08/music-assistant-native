<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MusicAssistant</RootNamespace>
    <AssemblyName>MusicAssistant</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Music Assistant</AssemblyTitle>
    <Product>Music Assistant</Product>
    <Company>Devin Green</Company>
    <Version>1.2.2.0</Version>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Unpackaged by default; pass -p:WindowsPackageType=MSIX to build the installer package -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild Condition="'$(WindowsPackageType)' == 'MSIX'">true</GenerateAppxPackageOnBuild>
    <AppxPackageDir>$(MSBuildProjectDirectory)\..\dist\</AppxPackageDir>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableMsixTooling>true</EnableMsixTooling>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Coding conventions: report .editorconfig style rules and missing XML docs on public members as build warnings -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Memory: workstation non-concurrent GC (no background GC thread/heap), conserve memory, no satellite resource strings -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window and tray icons, loaded from disk at runtime; the mono pair is the monochrome tray setting (tools\make-icons.ps1) -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\app-mono-light.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\app-mono-dark.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Source render for the MSIX logos only (tools\make-msix-assets.ps1); not shipped -->
    <None Remove="Assets\app-512.png" />
    <Content Include="Assets\Package\*.png" Condition="'$(WindowsPackageType)' == 'MSIX'" />
    <AppxManifest Include="Package.appxmanifest" Condition="'$(WindowsPackageType)' == 'MSIX'"><SubType>Designer</SubType></AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
    <!-- Remote access: WebRTC data channels (pure managed; brings BouncyCastle, used for X25519 too) -->
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <!-- Speaker: Opus decoding (pure managed port of libopus) -->
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

</Project>
