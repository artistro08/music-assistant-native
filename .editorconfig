# Code style for the Music Assistant Windows client.
#
# Encodes the Microsoft .NET C# coding conventions so Visual Studio and `dotnet build` flag drift:
# https://learn.microsoft.com/en-us/dotnet/csharp/fundamentals/coding-style/coding-conventions
#
# One deliberate deviation: the 65-character line limit in that article exists for code shown on the docs site and
# on phones, so it is not applied to this app's source.

root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{xml,xaml,csproj,props,targets,appxmanifest,manifest}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4
tab_width = 4

# Layout: Allman braces, one statement per line
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# Spacing: keep column-aligned assignments ("Align code consistently to improve readability")
csharp_space_around_binary_operators = ignore
csharp_space_around_declaration_statements = ignore
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true

# Line breaks go before binary operators
dotnet_style_operator_placement_when_wrapping = beginning_of_line

# Namespaces and using directives
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Language keywords instead of runtime type names
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# Implicit typing only when the type is apparent (new, cast, literal)
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_elsewhere = false:warning

# Object creation, initializers and collections
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning

# Simple using declarations
csharp_prefer_simple_using_statement = true:warning

# Diagnostics the conventions ask for
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning
dotnet_diagnostic.IDE0017.severity = warning
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0049.severity = warning
dotnet_diagnostic.IDE0063.severity = warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0090.severity = warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning

# "Avoid catching general exceptions"
dotnet_diagnostic.CA1031.severity = warning
