<Project Sdk="Microsoft.NET.Sdk">

  <!-- Protocol self-check: runs MassClient against a fake Music Assistant websocket server. `dotnet run` exits 0 on pass. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MusicAssistant.Check</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\MusicAssistant\ExceptionFilters.cs" Link="ExceptionFilters.cs" />
    <Compile Include="..\MusicAssistant\Api\Models.cs" Link="Api\Models.cs" />
    <Compile Include="..\MusicAssistant\Api\MassClient.cs" Link="Api\MassClient.cs" />
    <Compile Include="..\MusicAssistant\Api\IMassTransport.cs" Link="Api\IMassTransport.cs" />
    <Compile Include="..\MusicAssistant\Api\WebSocketTransport.cs" Link="Api\WebSocketTransport.cs" />
    <Compile Include="..\MusicAssistant\Api\OAuthLoopback.cs" Link="Api\OAuthLoopback.cs" />
    <Compile Include="..\MusicAssistant\Api\RemoteId.cs" Link="Api\RemoteId.cs" />
    <Compile Include="..\MusicAssistant\Sendspin\Base64Url.cs" Link="Sendspin\Base64Url.cs" />
    <Compile Include="..\MusicAssistant\Sendspin\Noise.cs" Link="Sendspin\Noise.cs" />
    <Compile Include="..\MusicAssistant\Sendspin\TimeFilter.cs" Link="Sendspin\TimeFilter.cs" />
    <Compile Include="..\MusicAssistant\Sendspin\Clock.cs" Link="Sendspin\Clock.cs" />
    <Compile Include="..\MusicAssistant\Sendspin\Identity.cs" Link="Sendspin\Identity.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

</Project>
